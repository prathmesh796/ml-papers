end_time":"2026-08-27T03:30:16.123857+00:00","exception":false,"start_time":"2026-08-27T03:30:16.111322+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["MAX_LEN = 64\n","\n","def tokenize(batch):\n","    en_texts = [item[\"en\"] for item in batch[\"translation\"]]\n","    fr_texts = [item[\"fr\"] for item in batch[\"translation\"]]\n","\n","    src = tokenizer(\n","        en_texts,\n","        truncation=True,\n","        padding=\"max_length\",\n","        max_length=MAX_LEN,\n","    )\n","\n","    tgt = tokenizer(\n","        fr_texts,\n","        truncation=True,\n","        padding=\"max_length\",\n","        max_length=MAX_LEN,\n","    )\n","\n","    return {\n","        \"src_ids\": src[\"input_ids\"],\n","        \"tgt_ids\": tgt[\"input_ids\"],\n","    }"]},{"cell_type":"code","execution_count":9,"id":"ef1fef6f","metadata":{"execution":{"iopub.execute_input":"2026-08-27T03:30:16.133646Z","iopub.status.busy":"2026-08-27T03:30:16.133435Z","iopub.status.idle":"2026-08-27T03:30:20.446215Z","shell.execute_reply":"2026-08-27T03:30:20.44538Z"},"papermill":{"duration":4.319452,"end_time":"2026-08-27T03:30:20.447734+00:00","exception":false,"start_time":"2026-08-27T03:30:16.128282+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"9728c6bcb3134825804c48c035878a64","version_major":2,"version_minor":0},"text/plain":["Map:   0%|          | 0/10000 [00:00<?, ? examples/s]"]},"metadata":{},"output_type":"display_data"}],"source":["train_data = train_data.map(tokenize, batched=True)"]},{"cell_type":"code","execution_count":10,"id":"06230f93","metadata":{"execution":{"iopub.execute_input":"2026-08-27T03:30:20.459197Z","iopub.status.busy":"2026-08-27T03:30:20.458444Z","iopub.status.idle":"2026-08-27T03:30:20.466741Z","shell.execute_reply":"2026-08-27T03:30:20.46591Z"},"papermill":{"duration":0.015502,"end_time":"2026-08-27T03:30:20.468237+00:00","exception":false,"start_time":"2026-08-27T03:30:2