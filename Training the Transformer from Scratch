424Z","iopub.status.idle":"2026-08-25T10:03:53.0881Z","shell.execute_reply.started":"2026-08-25T10:03:53.084209Z","shell.execute_reply":"2026-08-25T10:03:53.087407Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"rates=[lrate(i) for i in range(1,4000)]\n\nplt.figure(figsize=(7,4))\nplt.plot(rates)\nplt.title(\"Warmup Learning Rate\")\nplt.xlabel(\"Training Step\")\nplt.ylabel(\"Learning Rate\")\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-25T10:03:55.594164Z","iopub.execute_input":"2026-08-25T10:03:55.5949Z","iopub.status.idle":"2026-08-25T10:03:55.713996Z","shell.execute_reply.started":"2026-08-25T10:03:55.594852Z","shell.execute_reply":"2026-08-25T10:03:55.713365Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# 10 - Training\n\n","metadata":{}},{"cell_type":"code","source":"losses=[]\n\nstep=1\n\nfor epoch in range(10):\n\n    model.train()\n\n    total=0\n\n    for src,tgt in loader:\n\n        src=src.to(device)\n        tgt=tgt.to(device)\n\n        inp=tgt[:,:-1]\n        out=tgt[:,1:]\n\n        mask=make_mask(inp.size(1),device)\n\n        optimizer.param_groups[0][\"lr\"]=lrate(step)\n\n        pred,_=model(src,inp,mask)\n\n        loss=criterion(\n            pred.reshape(-1,vocab),\n            out.reshape(-1)\n        )\n\n        optimizer.zero_grad()\n\n        loss.backward()\n\n        torch.nn.utils.clip_grad_norm_(model.parameters(),1.0)\n\n        optimizer.step()\n\n        total+=loss.item()\n\n        step+=1\n\n    avg=total/len(loader)\n\n    losses.append(avg)\n\n    print(epoch+1,avg)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-25T10:03:59.324321Z","iopub.execute_input":"2026-08-25T10:03:59.325046Z","execution_failed":"2026-08-25T10:19:15.607Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"plt.figure(figsize=(6,4))\nplt.plot(losses,marker=\"o\")\nplt.xlabel(\"Epoch\")\nplt.ylabel(\"Loss\")\nplt.title(\"Trai