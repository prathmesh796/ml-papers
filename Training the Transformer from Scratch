ce":"# 12 - Visualize","metadata":{}},{"cell_type":"code","source":"sentence = \"The cat sat on the mat.\"\n\nsrc = tokenizer(sentence, return_tensors=\"pt\").input_ids.to(device)\ntgt = torch.tensor([[tokenizer.pad_token_id]], device=device)\n\nmask = make_mask(1, device)\n\nmodel.eval()\nwith torch.no_grad():\n    _, attn = model(src, tgt, mask)\n\n# First head\nweights = attn[0, 0].detach().cpu().numpy()\n\nsrc_tokens = tokenizer.convert_ids_to_tokens(src[0])\n\nplt.figure(figsize=(10, 3))\nplt.imshow(weights, cmap=\"Blues\", aspect=\"auto\")\nplt.xticks(range(len(src_tokens)), src_tokens, rotation=45)\nplt.yticks([0], [\"<start>\"])\nplt.xlabel(\"Source Tokens\")\nplt.ylabel(\"Decoder Token\")\nplt.title(\"Cross-Attention (Head 1)\")\nplt.colorbar()\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-25T10:13:39.474411Z","iopub.execute_input":"2026-08-25T10:13:39.474862Z","iopub.status.idle":"2026-08-25T10:13:39.632487Z","shell.execute_reply.started":"2026-08-25T10:13:39.474831Z","shell.execute_reply":"2026-08-25T10:13:39.631875Z"}},"outputs":[],"execution_count":null}]}