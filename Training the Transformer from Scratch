206,"end_time":"2026-08-27T03:22:24.55295+00:00","exception":false,"start_time":"2026-08-27T03:22:24.54089+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["MAX_LEN = 64\n","\n","def tokenize(batch):\n","    en_texts = [item[\"en\"] for item in batch[\"translation\"]]\n","    fr_texts = [item[\"fr\"] for item in batch[\"translation\"]]\n","\n","    src = tokenizer(\n","        en_texts,\n","        truncation=True,\n","        padding=\"max_length\",\n","        max_length=MAX_LEN,\n","    )\n","\n","    tgt = tokenizer(\n","        fr_texts,\n","        truncation=True,\n","        padding=\"max_length\",\n","        max_length=MAX_LEN,\n","    )\n","\n","    return {\n","        \"src_ids\": src[\"input_ids\"],\n","        \"tgt_ids\": tgt[\"input_ids\"],\n","    }"]},{"cell_type":"code","execution_count":9,"id":"37e3a736","metadata":{"execution":{"iopub.execute_input":"2026-08-27T03:22:24.563012Z","iopub.status.busy":"2026-08-27T03:22:24.562741Z","iopub.status.idle":"2026-08-27T03:22:28.843825Z","shell.execute_reply":"2026-08-27T03:22:28.843064Z"},"papermill":{"duration":4.288267,"end_time":"2026-08-27T03:22:28.845865+00:00","exception":false,"start_time":"2026-08-27T03:22:24.557598+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"application/vnd.jupyter.widget-view+json":{"model_id":"a29d082c0c844f97957f309bd25687c0","version_major":2,"version_minor":0},"text/plain":["Map:   0%|          | 0/10000 [00:00<?, ? examples/s]"]},"metadata":{},"output_type":"display_data"}],"source":["train_data = train_data.map(tokenize, batched=True)"]},{"cell_type":"code","execution_count":10,"id":"a557bb5b","metadata":{"execution":{"iopub.execute_input":"2026-08-27T03:22:28.857771Z","iopub.status.busy":"2026-08-27T03:22:28.857028Z","iopub.status.idle":"2026-08-27T03:22:28.864766Z","shell.execute_reply":"2026-08-27T03:22:28.863878Z"},"papermill":{"duration":0.015104,"end_time":"2026-08-27T03:22:28.866181+00:00","exception":false,"start_time":"2026-08-27T03